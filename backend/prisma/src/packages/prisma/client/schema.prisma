model telegram_ban_user {
  id               String     @id @unique @default(cuid())
  bot_id           String
  user_telegram_id String
  ban_from_type    String
  ban_from_id      String
  status           ban_status @default(Ban)
  at               DateTime   @default(now()) @updatedAt

  @@unique([user_telegram_id, ban_from_id])
