{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@repo/types/*": [
        "./src/common/types/*"
      ],
      "@repo/common/*": [
        "./src/common/*"
      ],
      "@repo/manager/*": [
        "src/manager/*"
      ],
      "@repo/socket/*": [
        "./src/socket/*"
      ],
      "@repo/lib/*": [
        "./src/lib/*"
      ],
      "@repo/utils/*": [
        "./src/utils/*"
      ]
    },
    "rootDir": "." /* Specify the root folder within your source files. */,
    "outDir": "./dist" /* Specify an output folder for all emitted files. */,
    "module": "ESNext",
    "moduleResolution": "node",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true
  }
}