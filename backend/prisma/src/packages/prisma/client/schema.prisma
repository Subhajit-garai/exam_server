model telegram {
  id          String   @id @unique @default(cuid())
  userid      String?
  telegramid  String?  @default("0000000000") // change it to teleid --> telegramid
  last_update DateTime @updatedAt
  User        User?
}

model telegramGroupInfo {
  id           String    @id @unique @default(cuid())
  groupid      String    @unique
  groupname    String
  groupType    groupType @default(group)
  grouplink    String?
  isTopic      Boolean   @default(false)
  isPremium    Boolean   @default(false)
