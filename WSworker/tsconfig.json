{
    "compilerOptions": {
        "target": "ES2020",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "noImplicitAny": false,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "baseUrl": ".",
        "paths": {
            "@repo/db/*": [
                "src/mocks/repo/db/*"
            ],
            "@repo/prisma/*": [
                "src/mocks/repo/prisma/*"
            ],
            "@prisma/client/runtime/client": [
                "src/mocks/prisma/client/runtime/client"
            ]
        }
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules"
    ]
}