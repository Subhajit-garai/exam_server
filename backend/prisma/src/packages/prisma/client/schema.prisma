model botQuizConfig {
  id String @id @unique @default(cuid())

  chatId   String? // Telegram chat ID / whats app location ID
  platform botPlatform @default(NONE) // e.g., "Telegram", "WhatsApp"

  quiz_topic_id    String
  exam             String
  nextQuestionTime Int     @default(40) // in seconds
  quizOpenFor      Int     @default(60) // in seconds
  variableDelay    Boolean @default(false)
  suffleQuestions  Boolean @default(true)

  question_count Int @default(0)

  created_by String
  created_at DateTime @default(now())

  User         User         @relation(fields: [created_by], references: [id])
  botQuizTopic botQuizTopic @relation(fields: [quiz_topic_id], references: [id])
}

model botQuizTopic {
  id         String   @id @unique @default(cuid())
  subject_id String
  topic_id   String
  created_by String
  created_at DateTime @default(now())

  User          User            @relation(fields: [created_by], references: [id])
  subject       Subject         @relation(fields: [subject_id], references: [id])
  topic         Topic           @relation(fields: [topic_id], references: [id])
  botQuizConfig botQuizConfig[]
}

model botInfo {
  id         String @id @unique @default(cuid())
  botuser_id String @unique
  token      String
  webhook    Json?
}

enum botPlatform {
  NONE
  WEB
  TELEGRAM
  WHATSAPP
}

// in dev

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique // e.g. "WELCOME50" or "PRIME2025"
  description    String? // Optional text describing the coupon
  discountType   String // "PERCENTAGE" | "FIXED"
  discountValue  Float // e.g. 10 (for 10%) or 100 (for ₹100 off)
  maxUses        Int? // Max number of total uses allowed
  usedCount      Int       @default(0) // How many times it’s already used
  perUserLimit   Int? // How many times a single user can use it
  minOrderAmount Float? // Minimum amount required to apply the coupon
  expiresAt      DateTime? // Expiration date (optional)
  isActive       Boolean   @default(true) // If false, coupon can’t be used
  createdBy      String? // Admin/user who created it
  createdAt      DateTime  @default(now())

  createdUser  User?         @relation(fields: [createdBy], references: [id])
  CouponUsages CouponUsage[] // Relation: which users used it
}

model CouponUsage {
  id       String   @id @default(cuid())
  userId   String
  couponId String
  usedAt   DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  coupon Coupon @relation(fields: [couponId], references: [id])

  @@unique([userId, couponId]) // prevents multiple uses by same user
}

model events {
  id          String    @id @unique @default(cuid())
  type        eventType
  description String
  data        Json
  conditions  Json
  isActive    Boolean   @default(true)
  created_by  UserRole  @default(Bot)
  created_at  DateTime  @default(now())
  runs        eventRuns @default(ONE) // ones / daily
  run_at      String // Exact time to run (if applicable) // or Any for the current/any time

  @@index([type]) // Index for faster filtering by event type
  @@index([runs]) // Index for scheduling queries
  @@index([run_at]) // Index for scheduling queries
}

enum eventType {
  RUN_NEW_QUIZ
  CREATE_QUIZ_CONTEST
  SEND_MESSAGE
  CREATE_DPP
  CREATE_EXAM
  CLEAR_BOT_CACHE
}

enum eventRuns {
  ONE
  DAILY
  WEEKLY
  MONTHLY
}

model TargetExam {
  id                String              @id @default(cuid())
  name              String              @unique // e.g., "GATE", "UPSC"
  shortCode         String?             @unique // e.g., "GATE", "CAT", "UPSC"
  description       String?
  examType          ExamScope           @default(NATIONAL) // examType to ExamScope
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  isDeleted         Boolean             @default(false)
  category          String              @default("not seted")
  subcriptionOffers subcriptionOffers[]
  examYears         ExamYear[]
}

model ExamYear {
  id String @id @default(cuid())

  targetExamId String

  year                  Int // e.g., 2025
  slug                  String     @unique // e.g., "gate-2025"
  status                ExamStatus @default(DRAFT)
  registrationOpenDate  DateTime?
  registrationCloseDate DateTime?
  examStartDate         DateTime?
  examEndDate           DateTime?
  resultDate            DateTime?
  category              String? // e.g., "Engineering", "Management"
  notes                 Json? // flexible field for extra info
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt
  isDeleted             Boolean    @default(false)
  // relation
  targetExam            TargetExam @relation(fields: [targetExamId], references: [id])
  Syllabus              Syllabus[]
}

model Exam_pattern {
  id              String        @id @unique @default(cuid())
  title           String?       @unique
  format          examformat    @default(Text) // it not needed 
  examname        String
  category        String
  syllabus        syllabusType  @default(Syllabus) // Syllabus mean it follow syllabus base question paper
  topics          String[]
  difficulty      diffcultlevel @default(Easy)
  part            Boolean?
  checkbox        Boolean?
  part_Count      Int           @default(1)
  total_questions Int[]
  check           check?
  marks_values    Int[]
  neg_values      Int[]
  is_multiple_ans Int[]         @default([0, 0]) // 0 mean false 1 mean it is multiple value ans
  created_by      String
  Exam            Exam[]
  User            User          @relation(fields: [created_by], references: [id])
}

model Exam {
  id         String  @id @unique @default(cuid())
  display_id String? @unique @default(nanoid(6))

  name     String? @default("No name")
  examname String

  category    String
  examtype    ExamType    @default(Exam)
  access_type access_type @default(Paid)
  mockSetId   String? // if examtype is Mock then it get mockset questions 

  exam_pattern_id  String
  ansid            String        @unique // not needed
  isMultipleAttemp Boolean       @default(true)
  isLive           Boolean       @default(true)
  Visibility       Visibility    @default(Private)
  creationstatus   CreationTypes @default(Processing)

  starttime String?  @default("08:00 pm") //or no limit // -> it start time , at this time you can join the exam , and join process open starttime + jointime 
  jointime  String?  @default("00:15 m") // Open HH:MM:SS
  duration  String   @default("02:00 h") // HH:MM   it is time  user can give or mark ans  , ans accept onlt starttime+jointime+timelimit+ 00:10 min
  date      DateTime @default(now())

  stage       ExamStage @default(Registration)
  register_id String    @default("")

  created_at DateTime? @default(now())
  created_by String

  ContestRegister ContestRegister @relation(fields: [register_id], references: [id])
  AnsSheet        AnsSheet        @relation(fields: [ansid], references: [id]) // not needed
  User            User            @relation(fields: [created_by], references: [id])
  exam_pattern    Exam_pattern    @relation(fields: [exam_pattern_id], references: [id])
  leaderboard     leaderboard[]
  questionsMap    question_map[]  @relation("ExamRelation")

  @@index([examtype])
}

enum access_type {
  Free
  Paid
}

enum ExamScope {
  NATIONAL
  STATE
  COLLEGE
  OTHER
}

enum ExamStatus {
  DRAFT
  UPCOMING
  ONGOING
  COMPLETED
  ARCHIVED
}

enum ExamType {
  Exam // dynamic exam set 
  Contest // compeations
  Mock // for fixed question set like 2024 jeca set 
  PYQ // 2024 jeca Exam 
  Subject // for topic 30 question
  Dpp
  Quiz
}

model Issue {
  id           String    @id @unique @default(cuid())
  type         IssueType
  sub_type     String?   @default("General")
  note         String?
  IssueDetails Json
  status       Status    @default(Created)
  upVote       Int       @default(0)
  downVote     Int       @default(0)
  priorityVote Int       @default(0)
  created_at   DateTime  @default(now())
  creator_role UserRole  @default(User)
  created_by   String?
}

enum IssueType {
  QUESTION
  UI
  EXAM
  PAYMENT
  LOGIN
  SIGNUP
}

model Subject {
  id             String         @id @unique @default(cuid())
  order          Int            @unique
  name           String         @unique
  shortName      String?        @unique
  description    String?        @default("No description provided")
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  slug           String         @unique
  iconUrl        String? // URL to an icon/image
  color          String? // hex color or Tailwind class
  isPublic       Boolean        @default(true)
  category       String // e.g. "Computer Science"
  level          String? // e.g. "Beginner", "Advanced"
  difficulty     Int? // e.g. 1-5 scale
  target_exam_id String?        @unique
  // Optional: If you want to link this subject to exams or other models
  topics         Topic[]
  botQuizTopic   botQuizTopic[]
  Questions      Questions[]
}

model TopicNoteVersion {
  id          String   @id @default(cuid())
  topicId     String
  content     String?
  version     Int?
  attachments String[] @default([])
  createdAt   DateTime @default(now())
  topic       Topic    @relation(fields: [topicId], references: [id])
}

model Topic {
  id   String @id @unique @default(cuid())
  name String @unique

  subjectId     String
  isparentTopic Boolean @default(false) //  NEW: Flag to indicate if this is a parent topic
  parentTopicId String? //  NEW: FK to parent topic (optional)
  parentTopic   Topic?  @relation("SubTopics", fields: [parentTopicId], references: [id])
  subtopics     Topic[] @relation("SubTopics")
  shortName     String? @unique

  order Int @default(100)

  description String?  @default("No description provided")
  slug        String   @unique
  iconUrl     String? // URL to an icon/image
  color       String? // hex color or Tailwind class
  tags        String[] @default([]) // or make a separate Tag model for many-to-many

  content String @default("no content added ")

  like      Int @default(0) // Number of likes
  dislike   Int @default(0) // Number of dislikes
  readCount Int @default(0) // Number of times the topic has been read
  comments  Int @default(0) // Number of comments on the topic

  isPublic          Boolean   @default(false)
  commentEnabled    Boolean   @default(true)
  verified          Boolean   @default(false)
  estimatedReadTime Int? // in minutes
  version           Int       @default(100)
  attachments       String[]  @default([])
  publishedAt       DateTime? // When the topic was published

  language         String? // e.g. "en", "hi", "bn"
  status           TopicStatus        @default(draft)
  subject          Subject            @relation(fields: [subjectId], references: [id])
  Comment          Comment[]
  TopicNoteVersion TopicNoteVersion[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  createdBy String?
  updatedBy String?

  relatedTopics   Topic[] @relation("RelatedTopics")
  relatedByTopics Topic[] @relation("RelatedTopics")
  User            User?   @relation(fields: [createdBy], references: [id])

  botQuizTopic botQuizTopic[]
  Questions    Questions[]

  @@unique([subjectId, order])
  @@index([subjectId])
}

model subcriptionOffers {
  id             String       @id @unique @default(cuid())
  markedPrice    Int
  discount       Int //  40 -> 40 % off /discount
  type           purchaseType
  title          String
  price          Int
  token          Int? // if offer
  isExamBased    Boolean      @default(false)
  target_exam_id String?
  tierId         String?
  time           String? // if subcription
  offerActive    String[]     @default([])
  offerInActive  String[]     @default([])
  btncolor       String       @default("")
  created_by     String?
  created_at     DateTime     @default(now())

  target_exam TargetExam? @relation(fields: [target_exam_id], references: [id])
  tier        Tier?       @relation(fields: [tierId], references: [id])
}

enum purchaseType {
  subcription
  token
}

model Order {
  id          String       @id @default(cuid())
  userId      String // Link to your user model
  order_id    String       @unique // if it is payment then it store rezorpay_order_id
  type        purchaseType @default(token)
  amount      Int
  token       Int?         @default(0)
  subcription String?      @default("")
  status      String       @default("pending") // Track order status
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  User User @relation(fields: [userId], references: [id])
}

model payment {
  id                  String   @id @unique @default(cuid())
  razorpay_order_id   String   @unique
  razorpay_payment_id String   @unique
  razorpay_signature  String
  amount              Int // Payment amount (in smallest currency unit, e.g., paise for INR)
  currency            String   @default("INR") // Default currency is INR
  status              String   @default("pending") // Payment status: pending, success, or failed
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  userId              String // Link to your user model
  User                User     @relation(fields: [userId], references: [id])
}

model Questions {
  id String @id @unique @default(cuid())

  title   String
  options String[]

  extra Json? // { "code":{void main (0) {}}}

  ans        String[]
  topic_id   String // create an record for unknown topic
  subject_id String // create an record for unknown subject

  format          examformat    @default(Text)
  category        String
  difficulty      diffcultlevel
  is_multiple_ans Boolean       @default(false)

  history     String[] @default([""])
  explanation String?  @default("no explanation added")
  links       String[] @default([""])

  status Status @default(Processing)
  weight Int    @default(0)

  created_by String
  created_at DateTime @default(now())
  User       User     @relation(fields: [created_by], references: [id])

  Subject Subject @relation(fields: [subject_id], references: [id])
  Topic   Topic   @relation(fields: [topic_id], references: [id])

  @@index([topic_id])
}

model mock_questions_set {
  id                         String              @id @unique @default(cuid())
  name                       String              @unique
  exam                       String
  category                   String
  description                String
  // questions                  Json?
  pattern                    String?             @default("no exam pattern seted")
  question_difficulty_weight Json? // { "Easy": 0, "MEDIUM": 0, "HARD": 0 }
  question_topic_count       Json? // { "OS": 0, "DBMS": 0, "C": 0 }
  question_part_count        Json? // { "part1": 0, "part2": 0 }
  total_questions            Int[]               @default([])
  selected_questions_count   Int[]               @default([])
  status                     CreationTypes       @default(Processing)
  created_at                 DateTime            @default(now())
  updated_at                 DateTime            @default(now()) @updatedAt
  questionsMap               mock_question_map[] @relation("MockRelation")
}

model question_map {
  id         String   @id @unique @default(cuid())
  number     Int      @default(0)
  questionid String
  part       String   @default("part1")
  options    String[] @default([])
  ans        String[] @default([])
  examid     String?
  isSuffled  Boolean  @default(false)
  exam       Exam?    @relation("ExamRelation", fields: [examid], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@unique([examid, questionid, part])
  @@index([examid])
}

model mock_question_map {
  id                 String              @id @unique @default(cuid())
  number             Int                 @default(0)
  questionid         String
  part               String              @default("part1")
  options            String[]            @default([])
  ans                String[]            @default([])
  mockid             String?
  isSuffled          Boolean             @default(false)
  mock_questions_set mock_questions_set? @relation("MockRelation", fields: [mockid], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@unique([mockid, questionid, part])
  @@index([mockid])
}

enum quiz_type {
  telegram_quiz
  quiz // web quiz
}

model quiz {
  id                   String  @id @unique @default(cuid())
  display_id           String? @unique @default(nanoid(6))
  quizRegister_id      String? @default("Private quiz")
  is_need_registration Boolean @default(false)
  name                 String? @default("No name")
  category             String

  topics   String[] @default([""]) // id 
  subjects String[] @default([""]) // id

  created_at DateTime? @default(now())
  created_by String    @default("No name")

  Visibility     Visibility    @default(Private)
  creationstatus CreationTypes @default(Processing)

  starttime String? @default("00:00 pm")
  endtime   String  @default("00:00 h")

  nextQuestionTime Int @default(40) // in seconds
  quizOpenFor      Int @default(60) // in seconds
  question_count   Int @default(0)

  quiz_type    quiz_type     @default(quiz)
  chatId       String? // Telegram chat ID // it can be group or private
  date         DateTime      @default(now())
  stage        ExamStage     @default(Registration)
  quizRegister quizRegister? @relation(fields: [quizRegister_id], references: [id])
  User         User          @relation(fields: [created_by], references: [id])

  quiz_question_map quiz_question_map[]
}

model quiz_question_map {
  id         String   @id @unique @default(cuid())
  number     Int      @default(0)
  questionid String
  options    String[] @default([])
  ans        String[] @default([])
  suffleKey  String?
  isSuffled  Boolean  @default(false)
  quizid     String?
  quiz       quiz?    @relation(fields: [quizid], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  @@unique([quizid, questionid])
  @@index([quizid])
}

model quizRegister {
  id      String   @id @unique @default(cuid())
  quiz_id String?  @unique @default("new_value_not_seted")
  count   Int      @default(0)
  users   String[] @default([])
  quiz    quiz[]
}

