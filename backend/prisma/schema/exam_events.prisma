enum EventStatus {
    completed
    current
    upcoming
}

model ExamEvent {
    id           String      @id @default(uuid())
    title        String
    date         DateTime
    description  String?
    status       EventStatus
    notification String?
    createdAt    DateTime    @default(now())
    updatedAt    DateTime    @updatedAt
    exam_year    String

    Exam_year ExamYear @relation(fields: [exam_year], references: [id])

    @@map("exam_events")
}
